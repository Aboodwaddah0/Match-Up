# Optional overrides for docker-compose.yml. Copy to .env (never commit .env).
# Every value below already has the same default inside the compose file.
POSTGRES_USER=fym
POSTGRES_PASSWORD=fym_dev_password
POSTGRES_DB=fym
DB_PORT=5433
API_PORT=3000

# E-mail (any SMTP provider). Empty: e-mails are printed to the API log in development.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Find Your Match <no-reply@yourdomain.com>
# Encrypts one-time tokens while their e-mail is queued (32 random bytes, base64). REQUIRED in production, never reuse JWT_ACCESS_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MAIL_OUTBOX_ENCRYPTION_KEY=
