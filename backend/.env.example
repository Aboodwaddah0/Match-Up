# Copy to .env for running the API on your machine (outside Docker).
# Docker Compose sets its own values, see ../docker-compose.yml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Matches the `db` service in docker-compose.yml (published on host port 5433).
DATABASE_URL=postgresql://fym:fym_dev_password@localhost:5433/fym?schema=public

# Auth. Generate a real one for any shared/production environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Base URL used in e-mail links (verify / reset).
APP_URL=http://localhost:3000
# Where the e-mail links point. A URL containing {token}: a mobile deep link or a web page. Empty = APP_URL/verify-email?token={token}.
# VERIFY_EMAIL_URL=fym://verify-email?token={token}
# RESET_PASSWORD_URL=fym://reset-password?token={token}
# Set to 1 behind ONE reverse proxy / load balancer so rate limits see real client IPs (0 = API exposed directly).
# With 0 behind a proxy, every client shares one rate-limit bucket.
TRUST_PROXY=0
# Hard limit for graceful shutdown in ms. Keep it below the orchestrator's kill timeout (Docker: 10 s).
# SHUTDOWN_TIMEOUT_MS=8000

# E-mail (any SMTP provider). Empty: e-mails are printed to the API log in development.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Find Your Match <no-reply@yourdomain.com>
