# Copy to .env for running the API on your machine (outside Docker).
# Docker Compose sets its own values, see ../docker-compose.yml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Matches the `db` service in docker-compose.yml (published on host port 5433).
DATABASE_URL=postgresql://fym:fym_dev_password@localhost:5433/fym?schema=public

# Auth. Generate a real one for any shared/production environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Base URL used in e-mail links (verify / reset).
APP_URL=http://localhost:3000
# Set to 1 behind one reverse proxy so rate limiting sees real client IPs.
TRUST_PROXY=0
