// Find Your Match — Prisma schema (v0.4)
//
// Companion files:
//   - ../../DATABASE_DESIGN.md  (rules and rationale)
//   - migrations/20261117000200_constraints_and_triggers/migration.sql
//     (everything Prisma cannot express: exclusion constraints, partial
//      unique indexes, CHECKs, triggers, views)
//
// Conventions
//   - DB columns/tables are snake_case (@map / @@map); Prisma fields are camelCase.
//   - UUID primary keys generated by Postgres (gen_random_uuid()).
//   - All timestamps are timestamptz (UTC). Local time is never stored.
//   - `time_range` columns are filled by DB triggers; they are optional here so
//     Prisma Client never has to write them.
//   - confirmed_count / available_spots are NOT columns (derived, see D17).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist, cube, earthdistance]
}

// ───────────────────────────── Enums ─────────────────────────────

enum PlatformRole {
  USER
  ADMIN

  @@map("platform_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("account_status")
}

enum Locale {
  ar
  en

  @@map("locale")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("token_type")
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  WINGER
  STRIKER

  @@map("position")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL

  @@map("skill_level")
}

enum PreferredFoot {
  RIGHT
  LEFT
  BOTH

  @@map("preferred_foot")
}

enum MatchFormat {
  F5
  F7
  F11

  @@map("match_format")
}

enum MatchType {
  OPEN_MATCH
  TEAM_CHALLENGE

  @@map("match_type")
}

enum MatchVisibility {
  PUBLIC
  PRIVATE

  @@map("match_visibility")
}

// OPEN, FULL           -> OPEN_MATCH only
// SCHEDULED            -> TEAM_CHALLENGE only
// the rest             -> both types
enum MatchStatus {
  OPEN
  FULL
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED_UNCONFIRMED

  @@map("match_status")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@map("request_status")
}

// MATCH_CANCELLED: set by the database when the match is cancelled. It frees
// the player's time slot (anti-overlap constraint only covers CONFIRMED) while
// keeping the fact that they were confirmed. Never penalizes reliability.
enum ParticipantStatus {
  CONFIRMED
  LEFT
  REMOVED
  MATCH_CANCELLED

  @@map("participant_status")
}

enum AttendanceStatus {
  UNKNOWN
  ATTENDED
  NO_SHOW

  @@map("attendance_status")
}

enum MatchSide {
  HOME
  AWAY

  @@map("match_side")
}

enum BookingSource {
  IN_APP
  EXTERNAL

  @@map("booking_source")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED

  @@map("booking_status")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED

  @@map("payment_status")
}

enum VenueStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("venue_status")
}

enum VenueStaffRole {
  MANAGER
  STAFF

  @@map("venue_staff_role")
}

enum VenuePermission {
  MANAGE_BOOKINGS
  MANAGE_FIELDS
  MANAGE_AVAILABILITY
  EDIT_VENUE
  MANAGE_STAFF
  VIEW_REPORTS

  @@map("venue_permission")
}

enum BlockReason {
  MAINTENANCE
  PRIVATE_EVENT
  OFFLINE_BOOKING
  OTHER

  @@map("block_reason")
}

enum TeamRole {
  CAPTAIN
  VICE_CAPTAIN
  MEMBER

  @@map("team_role")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("invitation_status")
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED

  @@map("challenge_status")
}

enum FavoriteTarget {
  PLAYER
  TEAM
  VENUE
  MATCH

  @@map("favorite_target")
}

enum ReportTarget {
  USER
  MATCH
  VENUE
  TEAM
  MESSAGE

  @@map("report_target")
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED

  @@map("report_status")
}

enum ConversationType {
  MATCH
  TEAM
  DIRECT

  @@map("conversation_type")
}

// ─────────────────────── Geo / lookup ───────────────────────

model City {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr   String @map("name_ar")
  nameEn   String @map("name_en")
  timezone String @default("Asia/Hebron")

  playerProfiles PlayerProfile[]
  venues         Venue[]
  matches        Match[]
  teams          Team[]

  @@unique([nameEn])
  @@map("city")
}

// ─────────────────────── Identity ───────────────────────

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String        @unique @db.Citext
  passwordHash    String        @map("password_hash")
  fullName        String        @map("full_name")
  avatarUrl       String?       @map("avatar_url")
  locale          Locale        @default(ar)
  timezone        String        @default("Asia/Hebron")
  platformRole    PlatformRole  @default(USER) @map("platform_role")
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  playerProfile PlayerProfile?
  tokens        UserToken[]
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  blocksMade    BlockedUser[]  @relation("Blocker")
  blockedBy     BlockedUser[]  @relation("Blocked")

  venuesOwned       Venue[]        @relation("VenueOwner")
  venueStaff        VenueStaff[]
  venueBlocksMade   VenueBlock[]   @relation("VenueBlockCreator")
  bookingsRequested Booking[]      @relation("BookingRequester")
  bookingsDecided   Booking[]      @relation("BookingDecider")
  bookingsCancelled Booking[]      @relation("BookingCanceller")
  bookingEvents     BookingEvent[]

  matchesOrganized   Match[]            @relation("MatchOrganizer")
  matchesCompleted   Match[]            @relation("MatchCompletedBy")
  matchesCancelled   Match[]            @relation("MatchCancelledBy")
  matchRequests      MatchRequest[]     @relation("RequestUser")
  matchRequestsMade  MatchRequest[]     @relation("RequestDecider")
  participations     MatchParticipant[] @relation("ParticipantUser")
  attendanceConfirms MatchParticipant[] @relation("AttendanceConfirmer")
  invitationsGot     MatchInvitation[]  @relation("InvitationInvitee")
  invitationsSent    MatchInvitation[]  @relation("InvitationInviter")
  matchEvents        MatchEvent[]

  teamMemberships   TeamMember[]
  teamInvitesGot    TeamInvitation[] @relation("TeamInviteInvitee")
  teamInvitesSent   TeamInvitation[] @relation("TeamInviteInviter")
  challengesDecided TeamChallenge[]

  reviewsWritten  Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewed")

  notifications Notification[]
  favorites     Favorite[]
  reportsFiled  Report[]       @relation("Reporter")
  reportsSolved Report[]       @relation("ReportResolver")

  conversations ConversationParticipant[]
  messages      Message[]

  @@map("user")
}

model UserToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_token")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_token")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_token")
}

model BlockedUser {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_user")
}

// ─────────────────────── Players ───────────────────────

model PlayerProfile {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @unique @map("user_id") @db.Uuid
  dateOfBirth      DateTime?      @map("date_of_birth") @db.Date
  bio              String?
  cityId           String?        @map("city_id") @db.Uuid
  latitude         Float?
  longitude        Float?
  primaryPosition  Position?      @map("primary_position")
  skillLevel       SkillLevel     @default(BEGINNER) @map("skill_level")
  preferredFoot    PreferredFoot? @map("preferred_foot")
  // Derived caches, recomputed by the service (never the source of truth).
  // Match counts, late cancellations and no-shows are derived from
  // match_participant rows on demand.
  ratingAvg        Decimal?       @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int            @default(0) @map("rating_count")
  reliabilityScore Decimal?       @map("reliability_score") @db.Decimal(5, 2)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City?            @relation(fields: [cityId], references: [id])
  positions PlayerPosition[]

  @@index([cityId])
  @@map("player_profile")
}

model PlayerPosition {
  playerProfileId String   @map("player_profile_id") @db.Uuid
  position        Position

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@id([playerProfileId, position])
  @@map("player_position")
}

// ─────────────────────── Venues ───────────────────────

model Venue {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String      @map("owner_id") @db.Uuid
  name         String
  description  String?
  cityId       String      @map("city_id") @db.Uuid
  address      String
  latitude     Float
  longitude    Float
  contactPhone String?     @map("contact_phone")
  timezone     String      @default("Asia/Hebron")
  status       VenueStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner  User         @relation("VenueOwner", fields: [ownerId], references: [id])
  city   City         @relation(fields: [cityId], references: [id])
  staff  VenueStaff[]
  images VenueImage[]
  fields VenueField[]

  @@index([ownerId])
  @@index([cityId])
  @@map("venue")
}

// The owner is Venue.ownerId (full rights, cannot be removed).
// Everyone else is a VenueStaff row with explicit permissions.
model VenueStaff {
  venueId     String            @map("venue_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  role        VenueStaffRole    @default(STAFF)
  permissions VenuePermission[]
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@id([venueId, userId])
  @@index([userId])
  @@map("venue_staff")
}

model VenueImage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String @map("venue_id") @db.Uuid
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("venue_image")
}

model VenueField {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId      String      @map("venue_id") @db.Uuid
  name         String
  format       MatchFormat
  capacity     Int
  pricePerHour Decimal     @map("price_per_hour") @db.Decimal(10, 2)
  currency     String      @default("ILS")
  slotMinutes  Int         @default(60) @map("slot_minutes")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue        Venue               @relation(fields: [venueId], references: [id])
  openingHours VenueOpeningHours[]
  blocks       VenueBlock[]
  bookings     Booking[]

  @@index([venueId])
  @@map("venue_field")
}

// Weekly working hours: LOCAL wall-clock times interpreted in Venue.timezone.
// weekday: 0 = Sunday ... 6 = Saturday. close_time > open_time (no overnight
// ranges; split a late-night field into two rows, e.g. 18:00-23:59 + 00:00-02:00 next day).
model VenueOpeningHours {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  weekday   Int      @db.SmallInt
  openTime  DateTime @map("open_time") @db.Time(0)
  closeTime DateTime @map("close_time") @db.Time(0)

  field VenueField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, weekday, openTime])
  @@map("venue_opening_hours")
}

// Owner/staff-managed unavailable period. NOT a booking.
model VenueBlock {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueFieldId String                    @map("venue_field_id") @db.Uuid
  startAt      DateTime                  @map("start_at") @db.Timestamptz(6)
  endAt        DateTime                  @map("end_at") @db.Timestamptz(6)
  timeRange    Unsupported("tstzrange")? @map("time_range")
  reason       BlockReason               @default(OTHER)
  note         String?
  groupId      String?                   @map("group_id") @db.Uuid
  createdById  String                    @map("created_by_id") @db.Uuid
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  field     VenueField @relation(fields: [venueFieldId], references: [id])
  createdBy User       @relation("VenueBlockCreator", fields: [createdById], references: [id])

  @@index([venueFieldId, startAt])
  @@index([groupId])
  @@map("venue_block")
}

// ─────────────────────── Bookings ───────────────────────

// Always created by a player/organizer (createdById), never by venue staff.
// IN_APP: venueFieldId required, 2h hold while PENDING.
// EXTERNAL: venueFieldId null, ext_* snapshot, self-reported (unverified).
model Booking {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source        BookingSource
  status        BookingStatus             @default(PENDING)
  createdById   String                    @map("created_by_id") @db.Uuid
  decidedById   String?                   @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?                 @map("decided_at") @db.Timestamptz(6)
  cancelledById String?                   @map("cancelled_by_id") @db.Uuid
  cancelReason  String?                   @map("cancel_reason")
  venueFieldId  String?                   @map("venue_field_id") @db.Uuid
  startAt       DateTime                  @map("start_at") @db.Timestamptz(6)
  endAt         DateTime                  @map("end_at") @db.Timestamptz(6)
  timeRange     Unsupported("tstzrange")? @map("time_range")
  holdExpiresAt DateTime?                 @map("hold_expires_at") @db.Timestamptz(6)
  totalPrice    Decimal                   @map("total_price") @db.Decimal(10, 2)
  currency      String                    @default("ILS")
  paymentStatus PaymentStatus             @default(UNPAID) @map("payment_status")
  notes         String?

  // External-venue snapshot (EXTERNAL bookings only)
  extVenueName    String? @map("ext_venue_name")
  extVenueAddress String? @map("ext_venue_address")
  extVenuePhone   String? @map("ext_venue_phone")
  extFieldInfo    String? @map("ext_field_info")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy   User           @relation("BookingRequester", fields: [createdById], references: [id])
  decidedBy   User?          @relation("BookingDecider", fields: [decidedById], references: [id])
  cancelledBy User?          @relation("BookingCanceller", fields: [cancelledById], references: [id])
  field       VenueField?    @relation(fields: [venueFieldId], references: [id])
  events      BookingEvent[]
  matches     Match[]

  @@index([venueFieldId, startAt])
  @@index([createdById, status])
  @@map("booking")
}

model BookingEvent {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([bookingId, createdAt])
  @@map("booking_event")
}

// ─────────────────────── Matches ───────────────────────

// capacity: OPEN_MATCH only = players wanted through the app (not the pitch total).
// There is deliberately NO confirmed_count / available_spots column (D17):
//   confirmed_count = COUNT(match_participant WHERE status = 'CONFIRMED')
//   available_spots = capacity - confirmed_count      (see view match_availability)
model Match {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId        String          @map("organizer_id") @db.Uuid
  bookingId          String?         @map("booking_id") @db.Uuid
  type               MatchType
  visibility         MatchVisibility @default(PUBLIC)
  format             MatchFormat
  status             MatchStatus
  title              String
  description        String?
  notes              String?
  startAt            DateTime        @map("start_at") @db.Timestamptz(6)
  endAt              DateTime        @map("end_at") @db.Timestamptz(6)
  timezone           String          @default("Asia/Hebron")
  cityId             String?         @map("city_id") @db.Uuid
  locationName       String?         @map("location_name")
  latitude           Float?
  longitude          Float?
  requiredSkillLevel SkillLevel?     @map("required_skill_level")
  pricePerPlayer     Decimal?        @map("price_per_player") @db.Decimal(10, 2)
  currency           String          @default("ILS")
  capacity           Int?

  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  completedById       String?   @map("completed_by_id") @db.Uuid
  closedUnconfirmedAt DateTime? @map("closed_unconfirmed_at") @db.Timestamptz(6)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledById       String?   @map("cancelled_by_id") @db.Uuid
  cancelReason        String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizer   User     @relation("MatchOrganizer", fields: [organizerId], references: [id])
  completedBy User?    @relation("MatchCompletedBy", fields: [completedById], references: [id])
  cancelledBy User?    @relation("MatchCancelledBy", fields: [cancelledById], references: [id])
  booking     Booking? @relation(fields: [bookingId], references: [id])
  city        City?    @relation(fields: [cityId], references: [id])

  requiredPositions MatchRequiredPosition[]
  requests          MatchRequest[]
  participants      MatchParticipant[]
  invitations       MatchInvitation[]
  teams             MatchTeam[]
  events            MatchEvent[]
  reviews           Review[]
  conversation      Conversation?
  resultOfChallenge TeamChallenge?

  @@index([organizerId, startAt])
  @@index([cityId, startAt])
  @@index([bookingId])
  @@map("match")
}

model MatchRequiredPosition {
  matchId  String   @map("match_id") @db.Uuid
  position Position
  count    Int      @default(1)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, position])
  @@map("match_required_position")
}

// The ASK. Never counts toward capacity. OPEN_MATCH only.
model MatchRequest {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String        @map("match_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  status      RequestStatus @default(PENDING)
  message     String?
  decidedById String?       @map("decided_by_id") @db.Uuid
  decidedAt   DateTime?     @map("decided_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  match       Match             @relation(fields: [matchId], references: [id])
  user        User              @relation("RequestUser", fields: [userId], references: [id])
  decidedBy   User?             @relation("RequestDecider", fields: [decidedById], references: [id])
  participant MatchParticipant?

  @@index([matchId, status])
  @@index([userId, status])
  @@map("match_request")
}

// CONFIRMED membership. One row per (match, user); re-joining reactivates it.
model MatchParticipant {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId                 String                    @map("match_id") @db.Uuid
  userId                  String                    @map("user_id") @db.Uuid
  requestId               String?                   @unique @map("request_id") @db.Uuid
  matchTeamId             String?                   @map("match_team_id") @db.Uuid
  status                  ParticipantStatus         @default(CONFIRMED)
  positionPlayed          Position?                 @map("position_played")
  joinedAt                DateTime                  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt                  DateTime?                 @map("left_at") @db.Timestamptz(6)
  isLateCancellation      Boolean                   @default(false) @map("is_late_cancellation")
  attendanceStatus        AttendanceStatus          @default(UNKNOWN) @map("attendance_status")
  attendanceConfirmedById String?                   @map("attendance_confirmed_by_id") @db.Uuid
  attendanceConfirmedAt   DateTime?                 @map("attendance_confirmed_at") @db.Timestamptz(6)
  // copy of the match window, filled by trigger; drives the anti-overlap constraint
  timeRange               Unsupported("tstzrange")? @map("time_range")

  match               Match         @relation(fields: [matchId], references: [id])
  user                User          @relation("ParticipantUser", fields: [userId], references: [id])
  request             MatchRequest? @relation(fields: [requestId], references: [id])
  matchTeam           MatchTeam?    @relation(fields: [matchTeamId], references: [id])
  attendanceConfirmer User?         @relation("AttendanceConfirmer", fields: [attendanceConfirmedById], references: [id])

  @@unique([matchId, userId])
  @@index([userId, status])
  @@index([matchId, status])
  @@map("match_participant")
}

// TEAM_CHALLENGE only: the two sides.
model MatchTeam {
  id      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId String    @map("match_id") @db.Uuid
  teamId  String    @map("team_id") @db.Uuid
  side    MatchSide

  match        Match              @relation(fields: [matchId], references: [id])
  team         Team               @relation(fields: [teamId], references: [id])
  participants MatchParticipant[]

  @@unique([matchId, side])
  @@unique([matchId, teamId])
  @@map("match_team")
}

model MatchInvitation {
  matchId     String           @map("match_id") @db.Uuid
  inviteeId   String           @map("invitee_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  match     Match @relation(fields: [matchId], references: [id])
  invitee   User  @relation("InvitationInvitee", fields: [inviteeId], references: [id])
  invitedBy User  @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@id([matchId, inviteeId])
  @@index([inviteeId, status])
  @@map("match_invitation")
}

model MatchEvent {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId    String       @map("match_id") @db.Uuid
  actorId    String?      @map("actor_id") @db.Uuid
  fromStatus MatchStatus? @map("from_status")
  toStatus   MatchStatus  @map("to_status")
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  match Match @relation(fields: [matchId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])

  @@index([matchId, createdAt])
  @@map("match_event")
}

// ─────────────────────── Teams ───────────────────────

// The captain is the TeamMember row with role CAPTAIN (one per team, partial
// unique index in the SQL migration). There is no captain_id column.
model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  logoUrl     String?  @map("logo_url")
  cityId      String?  @map("city_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  city          City?            @relation(fields: [cityId], references: [id])
  members       TeamMember[]
  invitations   TeamInvitation[]
  matchSides    MatchTeam[]
  challengesOut TeamChallenge[]  @relation("ChallengerTeam")
  challengesIn  TeamChallenge[]  @relation("ChallengedTeam")
  conversation  Conversation?

  @@index([cityId])
  @@map("team")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

model TeamInvitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String           @map("team_id") @db.Uuid
  inviteeId   String           @map("invitee_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  team      Team @relation(fields: [teamId], references: [id])
  invitee   User @relation("TeamInviteInvitee", fields: [inviteeId], references: [id])
  invitedBy User @relation("TeamInviteInviter", fields: [invitedById], references: [id])

  @@index([inviteeId, status])
  @@map("team_invitation")
}

model TeamChallenge {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengerTeamId String          @map("challenger_team_id") @db.Uuid
  challengedTeamId String          @map("challenged_team_id") @db.Uuid
  format           MatchFormat
  proposedStartAt  DateTime        @map("proposed_start_at") @db.Timestamptz(6)
  message          String?
  status           ChallengeStatus @default(PENDING)
  expiresAt        DateTime        @map("expires_at") @db.Timestamptz(6)
  decidedById      String?         @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?       @map("decided_at") @db.Timestamptz(6)
  resultingMatchId String?         @unique @map("resulting_match_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  challenger Team   @relation("ChallengerTeam", fields: [challengerTeamId], references: [id])
  challenged Team   @relation("ChallengedTeam", fields: [challengedTeamId], references: [id])
  decidedBy  User?  @relation(fields: [decidedById], references: [id])
  match      Match? @relation(fields: [resultingMatchId], references: [id])

  @@index([challengedTeamId, status])
  @@index([challengerTeamId, status])
  @@map("team_challenge")
}

// ─────────────────────── Platform ───────────────────────

// 1–5 scores. "Attendance" is NOT reviewer-rated: it is objective and comes
// from organizer-confirmed MatchParticipant.attendanceStatus.
model Review {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId            String   @map("match_id") @db.Uuid
  reviewerId         String   @map("reviewer_id") @db.Uuid
  reviewedId         String   @map("reviewed_id") @db.Uuid
  sportsmanshipScore Int      @map("sportsmanship_score") @db.SmallInt
  skillScore         Int      @map("skill_score") @db.SmallInt
  reliabilityScore   Int      @map("reliability_score") @db.SmallInt
  comment            String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  match    Match @relation(fields: [matchId], references: [id])
  reviewer User  @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewed User  @relation("Reviewed", fields: [reviewedId], references: [id])

  @@unique([matchId, reviewerId, reviewedId])
  @@index([reviewedId])
  @@map("review")
}

// Transactional outbox: written in the SAME transaction as the state change.
// `params` carries data, not rendered text, so it can be rendered in ar/en.
model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         String
  params       Json      @default("{}")
  resourceType String?   @map("resource_type")
  resourceId   String?   @map("resource_id") @db.Uuid
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  pushSentAt   DateTime? @map("push_sent_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("notification")
}

model Favorite {
  userId     String         @map("user_id") @db.Uuid
  targetType FavoriteTarget @map("target_type")
  targetId   String         @map("target_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, targetType, targetId])
  @@map("favorite")
}

model Report {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  targetType   ReportTarget @map("target_type")
  targetId     String       @map("target_id") @db.Uuid
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedById String?      @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter   User  @relation("Reporter", fields: [reporterId], references: [id])
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("report")
}

// ─────────────────────── Chat (later phase) ───────────────────────

model Conversation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ConversationType
  matchId   String?          @unique @map("match_id") @db.Uuid
  teamId    String?          @unique @map("team_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  match        Match?                    @relation(fields: [matchId], references: [id])
  team         Team?                     @relation(fields: [teamId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversation")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participant")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("message")
}
